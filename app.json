{
  "expo": {
    "name": "TimeTrack OT",
    "slug": "Natively",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/timetrack-icon.png",
    "userInterfaceStyle": "dark",
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000"
    },
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/timetrack-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.timetrackot",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/timetrack-icon.png",
        "backgroundColor": "#2563EB"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.timetrackot",
      "versionCode": 26,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "WAKE_LOCK",
        "USE_FULL_SCREEN_INTENT",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "com.android.alarm.permission.SET_ALARM",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/images/timetrack-icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/withShowWhenLocked",
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/timetrack-icon.png",
          "color": "#2563EB",
          "defaultChannel": "activity-reminders",
          "sounds": [
            "./assets/sounds/alarm.wav"
          ]
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "scheme": "timetrackot",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "890a7fe6-a4a4-4bb5-8819-042a465115fe"
      }
    },
    "owner": "wick.51"
  }
}
